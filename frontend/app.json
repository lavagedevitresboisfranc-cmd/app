{
  "expo": {
    "name": "Gexia360",
    "slug": "crystaltask",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Prendre des photos pour vos estimations",
        "NSPhotoLibraryUsageDescription": "Joindre des photos à vos estimations",
        "NSMicrophoneUsageDescription": "Enregistrer des notes vocales",
        "NSLocationWhenInUseUsageDescription": "Utiliser votre position pour remplir l'adresse"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permettre l'accès aux photos pour joindre des reçus et factures.",
          "cameraPermission": "Permettre l'accès à la caméra pour scanner des reçus et factures."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Enregistrer des notes vocales pour vos rendez-vous"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
